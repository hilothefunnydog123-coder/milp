{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,

    /* ---- strictness ----------------------------------------------------
       `strict` is the floor, not the ceiling. The four flags below are the
       ones that actually catch bugs in a codebase like this one:
         • noUncheckedIndexedAccess   — `array[0]` and `record[key]` are
           `T | undefined`, which is the truth. Most crashes in a UI that
           renders model output start with an index that wasn't there.
         • exactOptionalPropertyTypes — `{ contact?: string }` means the key
           may be absent, not that it may be present and undefined. It keeps
           JSON round-trips honest.
         • noImplicitReturns / noFallthroughCasesInSwitch — the exhaustive
           `switch` statements the API contract relies on stay exhaustive.
       ------------------------------------------------------------------- */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,

    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
